# PHPStan configuration for Twig Inspector Bundle.
#
# Static analysis on src/ only (level 8). Keeps PHP 8.1+ and Symfony 6|7|8 compatibility.
# Run: make phpstan
parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            message: '#Call to function method_exists\(\) with.*will always evaluate to true#'
            path: src/EventSubscriber/*.php
