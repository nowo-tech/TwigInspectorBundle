{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Instructions', kind: 'content'} %}
    {% block section_body %}
        <ol>
            <li>Look at the bottom of the page for the Symfony Web Profiler toolbar</li>
            <li>Find the <code class="nowo-ui-code">&lt;/&gt;</code> icon (Twig Inspector)</li>
            <li>Check the "enable" checkbox to activate Twig Inspector</li>
            <li>The page will reload with inspection enabled</li>
            <li>Hover over any HTML element to see which template rendered it</li>
            <li>Click on elements to open the template in your IDE</li>
            <li><strong>Filter:</strong> type <code class="nowo-ui-code">header</code>, <code class="nowo-ui-code">footer</code>, <code class="nowo-ui-code">instructions</code> or <code class="nowo-ui-code">feature</code> in the toolbar to highlight only those templates</li>
        </ol>
    {% endblock %}
{% endembed %}
