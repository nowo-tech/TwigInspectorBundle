{% set _page_title = title %}
{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Template blocks', intro: 'This demo uses multiple templates so you can try the Inspector filter.', kind: 'list'} %}
    {% block section_body %}
        <ul>
            <li><strong>Variables:</strong> {{ _page_title }}, {{ message }}</li>
            <li><strong>Loops:</strong> Iterating over items array</li>
            <li><strong>Includes:</strong> Each section is a separate <code class="nowo-ui-code">_*.html.twig</code> file</li>
            <li><strong>Filter:</strong> Type a template name (e.g. <code class="nowo-ui-code">header</code>, <code class="nowo-ui-code">footer</code>) to see only those blocks highlighted</li>
        </ul>
    {% endblock %}
{% endembed %}
