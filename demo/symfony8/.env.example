# Demo environment template (REQ-DEMO-003). Copy to .env (e.g. cp .env.example .env) and adjust.
# Do not commit .env, .env.dev or .env.*.local files.

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, Twig Inspector).
APP_ENV=dev

# APP_SECRET: Secret used for CSRF/session signing. Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: Enable detailed debug output (1 in dev, 0 in prod). Twig Inspector only works with debug on.
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

# PORT: Host port mapped to FrankenPHP :80 inside the container.
PORT=8003

# TRUSTED_PROXIES: Proxies whose X-Forwarded-* headers are trusted (Caddy in front of PHP).
# Read https://symfony.com/doc/current/deployment/proxies.html
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# TRUSTED_HOSTS (optional): host name regex accepted by the app; leave commented in the demo.
#TRUSTED_HOSTS='^localhost|example\.com$'

###> symfony/routing ###
# DEFAULT_URI: Base URL used to generate URLs in non-HTTP contexts (CLI commands); keep it in sync with PORT.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8003
###< symfony/routing ###
