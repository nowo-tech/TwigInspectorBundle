{
  "name": "@nowo-tech/twig-inspector-bundle",
  "version": "1.0.32",
  "description": "Assets build configuration for Twig Inspector Bundle",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "vite build && pnpm run build:css",
    "build:css": "sass src/Resources/assets/src/style.scss src/Resources/views/assets/dist/style.min.css --style=compressed --no-source-map",
    "build:dev": "vite build --mode development && pnpm run build:css",
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "clean": "rm -rf src/Resources/views/assets/dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.2",
    "sass": "^1.77.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "author": "Héctor Franco Aceituno <hectorfranco@nowo.tech>",
  "license": "MIT"
}
